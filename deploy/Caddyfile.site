# Add to the server's Caddyfile; Caddy fetches the certificate once DNS points here.
{$SITE_DOMAIN} {
	request_body {
		max_size 40MB
	}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Only the finance app calls the internal API, over the docker network; never from the internet.
	@internal path /api/internal/*
	respond @internal 404
	reverse_proxy site:3200
}
